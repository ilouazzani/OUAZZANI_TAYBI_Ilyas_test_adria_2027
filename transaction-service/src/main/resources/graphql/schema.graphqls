type Query {
    transactions: [Transaction]
    transactionById(id: ID!): Transaction
    transactionsByAccount(accountId: ID!): [Transaction]
}

type Mutation {
    createTransaction(request: TransactionInput!): Transaction
}

type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
    createdAt: String!
}

input TransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
}
