type Query {
    accounts: [Account]
    accountById(id: ID!): Account
}

type Mutation {
    createAccount(request: AccountInput!): Account
    updateBalance(id: ID!, amount: Float!): Account
    transfer(sourceAccountId: ID!, destinationAccountId: ID!, amount: Float!): Boolean
}

type Account {
    id: ID!
    customerReference: String!
    status: AccountStatus!
    currency: String!
    balance: Float!
}

enum AccountStatus {
    ACTIVE
    BLOCKED
}

input AccountInput {
    customerReference: String!
    status: AccountStatus
    currency: String!
    balance: Float!
}
